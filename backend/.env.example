# Plantilla de configuracion del backend.
# Copiala como .env y completa los valores. .env esta en .gitignore: nunca lo subas.

# ---------------------------------------------------------------- base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/fashionstore

# ---------------------------------------------------------------- seguridad
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=True

# ---------------------------------------------------------------- pagos con tarjeta
# Ver doc de Stripe. Dejar vacio desactiva el cobro con tarjeta.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=BOB

# ---------------------------------------------------------------- servicios
AI_API_URL=
AI_API_KEY=


# ================================================================= vestidor virtual (Decart, CU-07)
# La misma clave sirve para los dos flujos del probador:
#   - realtime (lucy-vton-3.5): emision del token efimero en /virtual/token
#   - foto->foto (lucy-image-2): generacion con tarifa plana en /virtual/prueba
# Dejarla vacia deja el probador deshabilitado (el boton avisa que falta configurar).
DECART_API_KEY=
DECART_BASE_URL=https://api.decart.ai
DECART_VION_MODELO=lucy-vton-latest

# Resolucion de la Process API foto->foto. Cada generacion tiene tarifa plana:
# 480p = US$0.01, 720p = US$0.02. 480p es el costo por probada del demo.
DECART_PROCESS_RESOLUCION=480p

# Origenes web autorizados a usar el token de Decart (flujo realtime). Deben
# coincidir con CORS.
DECART_ORIGENES_PERMITIDOS=http://localhost:4200,http://localhost:8080


# ================================================================= pasarela QR
# Libre de (Todotix). Sin esto el punto de venta sigue funcionando en modo
# SIMULADO: los QR se generan localmente y ningun dinero se mueve. Es el
# estado por defecto a proposito, para no cobrar de verdad por accidente.
#
# Documentacion: manual de integracion v2.7
#   produccion: https://api.todotix.com
#   pruebas:    http://www.todotix.com:10888   <- ojo, HTTP plano
# El appkey se pide a libelula@todotix.com. Ver docs/solicitar-appkey-libelula.txt

# simulado | libelula
QR_PROVEEDOR=simulado

# Lo entrega Libelula, uno por empresa. El de pruebas NUNCA va a produccion:
# las recaudaciones hechas con el no son honradas.
QR_APPKEY=

# Ambiente de la pasarela. Tiene que COINCIDIR con el del appkey: un appkey de
# pruebas contra api.todotix.com no funciona.
QR_BASE_URL=http://www.todotix.com:10888

# URL publica del backend, sin la ruta del webhook (la agrega el codigo).
# Libelula necesita alcanzarla desde internet, asi que localhost no sirve:
# usá un tunel (cloudflared) o un dominio propio.
QR_CALLBACK_BASE=

# Donde aterriza el CLIENTE despues de pagar. Distinto del callback: el
# callback es para el sistema, esto es para la persona. Si se deja vacio, la
# pasarela redirige al callback_url y el cliente ve un JSON de error, asi que
# el sistema se niega a crear el cobro mientras este vacio.
QR_URL_RETORNO=http://localhost:4200/ventas/punto-venta

# Datos fiscales de la empresa.
QR_RAZON_SOCIAL=
QR_NIT=
QR_CLIENTE_CI=
QR_CLIENTE_APELLIDO=

# 0 = no factura. Poner 1 obliga a completar Razon social y NIT.
QR_EMITE_FACTURA=0

# Moneda del cobro (BOB o USD).
QR_MONEDA=BOB

# Minutos de vigencia del QR en ESTE sistema. Ojo: la pasarela usa fecha de
# vencimiento con granularidad diaria, asi que puede seguir aceptando el pago
# horas despues. El webhook detecta eso y lo trata como pago tardio.
QR_TIMEOUT_MINUTOS=30
